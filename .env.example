# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical, absolute URL of the deployed site (no trailing slash).
# Used for canonical tags, Open Graph URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://karansuthar.vercel.app

# ---------------------------------------------------------------------------
# EmailJS — powers the contact form with no backend.
# Create a free account at https://www.emailjs.com/ and grab these three values
# from Email Services / Email Templates / Account -> API Keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Google Analytics 4 measurement ID. Leave empty to disable GA entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification code (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
